output application/java
---
attributes.queryParams.inputPath]]></ee:set-variable>
				<ee:set-variable variableName="outputPath" ><![CDATA[%dw 2.0
output application/java
---
attributes.queryParams.outputPath]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
